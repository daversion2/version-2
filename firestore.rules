rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // USER DATA — users/{userId}/**
    // Only the authenticated owner can read/write their own data.
    // ========================================================================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Writes are owner-only AND may not touch the privilege flags.
      //
      // The admin gates throughout this file read is_admin off this same
      // document, so the owner must not be able to set it. Keep these guards —
      // see the security audit for the reasoning before changing them.
      //
      // Nothing in the app writes either flag, and every user-doc write passes
      // merge: true, so this costs the client nothing. Grant the flags from the
      // Firebase console or an Admin SDK script; both bypass these rules.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['is_admin', 'is_coach']);
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['is_admin', 'is_coach']);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Subcollections: challenges, habits, completionLogs, categories,
      // challengeStats, reflections, skipLogs, skipReviews.
      // The wildcard below covers any new one automatically — owner-only.
      match /{subcollection}/{docId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        // Creating a Compose doc starts a 2 GiB Cloud Function, so only
        // admins may create one (the function also checks).
        allow create: if request.auth != null && request.auth.uid == userId
                      && (subcollection != 'lab_compose'
                          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true);
      }
    }

    // Admins may read and list every profile (the Admin dashboard's user
    // counts). Nobody else can read another user's profile: it holds their
    // email and push token. Username availability goes through the
    // checkUsernameAvailable Cloud Function instead of a client query.
    match /users/{userId} {
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // CHALLENGE LIBRARY — challengeLibrary/{docId}
    // All authenticated users can read.
    // Only admins can write (is_admin flag on user doc).
    // ========================================================================
    match /challengeLibrary/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // PROGRAMS — programs/{docId}
    // All authenticated users can read. Only admins can write.
    // ========================================================================
    match /programs/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // FUN FACTS — funFacts/{docId}
    // All authenticated users can read.
    // Only admins can write.
    // ========================================================================
    match /funFacts/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // REWARD MESSAGES — rewardMessages/{docId}
    // All authenticated users can read.
    // Only admins can write.
    // ========================================================================
    match /rewardMessages/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // NEUROSCIENCE TIDBITS — neuroscienceTidbits/{docId}
    // All authenticated users can read.
    // Only admins can write.
    // User-specific shown tracking is in users/{userId}/shownTidbits/ (covered above).
    // ========================================================================
    match /neuroscienceTidbits/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // PRACTICE CATALOG — practiceCatalog/{docId}
    // The curated practices, editable without a code change.
    // All authenticated users can read; only admins can write.
    // ========================================================================
    match /practiceCatalog/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // APP COPY — appCopy/{key}
    // Admin edits to on-screen wording (services/appCopy.ts). Doc id is the
    // copy key; a missing doc means "show the default in code".
    // All authenticated users can read; only admins can write.
    // ========================================================================
    match /appCopy/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // APP CONFIG — config/{docId}
    // Admin-editable app configuration (e.g. config/onboarding).
    // All authenticated users can read (new users read onboarding content
    // right after signup). Only admins can write.
    // ========================================================================
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ========================================================================
    // RULES ENGINE — rules/{docId}
    // Admin-configured triggers for push notifications and in-app popups.
    // All authenticated users can read (the client evaluates modal/banner
    // rules locally). Only admins can write.
    // ========================================================================
    match /rules/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // Every other top-level collection — including the retired social ones
    // (teams, buddyChallenges, duoStreaks, inspirationFeed, fistBumps,
    // challengeReviews, reviewVotes, challengeSubmissions, coachApplications)
    // — has no rule, so clients are denied. deleteAccount (Admin SDK) still
    // sweeps old data from them.

    // ========================================================================
    // COMPOSE ALLOWANCE — composeUsage/{userId}
    // The owner can read their own (to show minutes left). Only the
    // composeSession Cloud Function writes it, so nobody can reset it.
    // ========================================================================
    match /composeUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================================================
    // GUIDED RECORDINGS — guidedRecordings/{id}
    // Meditate's catalog of approved guided recordings. Any signed-in user can
    // read it; nobody writes it from the app — only scripts/publishMeditations.ts,
    // which publishes nothing the founder hasn't approved.
    // ========================================================================
    match /guidedRecordings/{id} {
      allow read: if request.auth != null;
    }
  }
}
