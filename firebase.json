{
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "redirects": [
      { "source": "/privacy-policy", "destination": "/privacy", "type": 301 },
      { "source": "/terms-and-conditions", "destination": "/terms", "type": 301 },
      { "source": "/how-it-works", "destination": "/", "type": 301 },
      { "source": "/about", "destination": "/", "type": 301 },
      { "source": "/blog/**", "destination": "/", "type": 301 },
      { "source": "/blog", "destination": "/", "type": 301 },
      { "source": "/faq", "destination": "/support", "type": 301 },
      { "source": "/neuro-nudges", "destination": "/", "type": 301 },
      { "source": "/cart", "destination": "/", "type": 301 }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run sync-core",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "hub": {
      "host": "127.0.0.1"
    },
    "logging": {
      "host": "127.0.0.1"
    },
    "eventarc": {
      "host": "127.0.0.1"
    },
    "tasks": {
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    }
  }
}
